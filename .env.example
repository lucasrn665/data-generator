# Autenticação opcional lida pelo DefaultAzureCredential (nunca versionar valores)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Sobrescritas ADLS Gen2 (integração desabilitada por padrão)
BANKING_GENERATOR_ADLS_ENABLED=false
BANKING_GENERATOR_ADLS_ACCOUNT_URL=
BANKING_GENERATOR_ADLS_FILE_SYSTEM=synthetic-data
BANKING_GENERATOR_ADLS_BASE_DIRECTORY=banking
BANKING_GENERATOR_ADLS_OVERWRITE=false

# Sobrescritas Event Hubs (integração desabilitada por padrão)
BANKING_GENERATOR_EVENT_HUBS_ENABLED=false
BANKING_GENERATOR_EVENT_HUBS_FULLY_QUALIFIED_NAMESPACE=
BANKING_GENERATOR_EVENT_HUBS_EVENTHUB_NAME=synthetic-events
BANKING_GENERATOR_EVENT_HUBS_EVENTS_PER_SECOND=0
BANKING_GENERATOR_EVENT_HUBS_MAX_BATCH_SIZE=100
BANKING_GENERATOR_EVENT_HUBS_STARTING_POSITION=beginning
